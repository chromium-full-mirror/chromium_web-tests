query {
  id: "meet_jank_query"
  table {
    table_name: "meet_jank_output"
    module_name: "sql_packages.queries.meet_jank"
    column_names: "hist_name"
    column_names: "avg"
    column_names: "count"
    column_names: "total"
    column_names: "max"
    column_names: "p95"
    column_names: "p90"
    column_names: "p75"
    column_names: "p50"
  }
}

metric_spec: {
  id: "cuj.meet_jank.avg"
  dimensions: "hist_name"
  value: "avg"
  polarity: LOWER_IS_BETTER
  query: {
    inner_query_id: "meet_jank_query"
  }
}

metric_spec: {
  id: "cuj.meet_jank.count"
  dimensions: "hist_name"
  value: "count"
  polarity: LOWER_IS_BETTER
  query: {
    inner_query_id: "meet_jank_query"
  }
}

