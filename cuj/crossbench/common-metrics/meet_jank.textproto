  id: "cuj.meet_jank.total"
  dimensions: "hist_name"
  value: "total"
  polarity: LOWER_IS_BETTER
  query: {
    inner_query_id: "meet_jank_query"
  }
}

metric_spec: {
  id: "cuj.meet_jank.max"
  dimensions: "hist_name"
  value: "max"
  polarity: LOWER_IS_BETTER
  query: {
    inner_query_id: "meet_jank_query"
  }
}

metric_spec: {
  id: "cuj.meet_jank.p95"
  dimensions: "hist_name"
  value: "p95"
  polarity: LOWER_IS_BETTER
  query: {
    inner_query_id: "meet_jank_query"
  }
}

metric_spec: {
  id: "cuj.meet_jank.p90"
  dimensions: "hist_name"
  value: "p90"
  polarity: LOWER_IS_BETTER
  query: {
    inner_query_id: "meet_jank_query"
  }
}

metric_spec: {
  id: "cuj.meet_jank.p75"
  dimensions: "hist_name"
  value: "p75"
  polarity: LOWER_IS_BETTER
  query: {
    inner_query_id: "meet_jank_query"
  }
}

metric_spec: {
  id: "cuj.meet_jank.p50"
  dimensions: "hist_name"
  value: "p50"
  polarity: LOWER_IS_BETTER
  query: {
    inner_query_id: "meet_jank_query"
  }
