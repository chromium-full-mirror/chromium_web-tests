{
  // Extracts metrics from one histogram logged with the UMA_HISTOGRAM_COUNT
  // macro.
  name: $[NAME]
  sql: ./queries/uma_histogram_count.sql
  replacements: {
    METRIC_NAME: $[NAME]
  }
}