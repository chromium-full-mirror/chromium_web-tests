  polarity: HIGHER_IS_BETTER
  query: {
    inner_query_id: "sys_memory_stats_query"
  }
}

metric_spec: {
  id: "cuj.common-metrics.sys_memory_stats.mem_available_mb.avg"
  value: "mem_available_avg_mb"
  polarity: HIGHER_IS_BETTER
  query: {
    inner_query_id: "sys_memory_stats_query"
  }
}

metric_spec: {
  id: "cuj.common-metrics.sys_memory_stats.swap_used_mb.max"
