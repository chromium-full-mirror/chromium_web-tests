query {
  id: "sys_memory_stats_query"
  table {
    table_name: "sys_memory_stats_output"
    module_name: "sql_packages.queries.sys_memory_stats"
    column_names: "mem_free_min_mb"
    column_names: "mem_free_avg_mb"
    column_names: "mem_available_min_mb"
    column_names: "mem_available_avg_mb"
    column_names: "swap_used_max_mb"
    column_names: "swap_used_avg_mb"
    column_names: "dirty_max_mb"
    column_names: "writeback_max_mb"
    column_names: "gpu_memory_max_mb"
    column_names: "pswpin_pages"
    column_names: "pswpout_pages"
    column_names: "pgpgin_kb"
    column_names: "pgpgout_kb"
    column_names: "pgfault_count"
  }
}

metric_spec: {
  id: "cuj.common-metrics.sys_memory_stats.mem_free_mb.min"
  value: "mem_free_min_mb"
  polarity: HIGHER_IS_BETTER
  query: {
    inner_query_id: "sys_memory_stats_query"
  }
}

metric_spec: {
  id: "cuj.common-metrics.sys_memory_stats.mem_free_mb.avg"
  value: "mem_free_avg_mb"
  polarity: HIGHER_IS_BETTER
  query: {
    inner_query_id: "sys_memory_stats_query"
  }
}

metric_spec: {
  id: "cuj.common-metrics.sys_memory_stats.mem_available_mb.min"
