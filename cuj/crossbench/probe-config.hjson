{
  probes: [
    {
      name: screenshot
    }
    {
      name: dump_html
    }
    {
      name: trace_processor
      module_paths: [
        ./sql_packages
      ]
      metric_definitions: [
        ./common-metrics/cpu_usage_stat.textproto
        ./common-metrics/lmk_kill_list.textproto
        ./common-metrics/lmk_kill_count.textproto
        ./common-metrics/uma_histogram_summaries.textproto
        ./common-metrics/battery_start_percent.textproto
        ./common-metrics/system_info.textproto
        ./common-metrics/browser_info.textproto
        ./common-metrics/slow_inputs.textproto
        $[...METRIC_DEFINITIONS]
      ]
    }
    {
      name: perfetto
      textproto: $[TRACE_CONFIG]
      start_tracing_sequence: story_setup
    }
    {
      name: downloads
    }
    {
      name: meminfo
    }
    $[...ADDITIONAL_PROBES]
  ]
}
