# texproto can be directly copied from https://ui.perfetto.dev/#!/record?p=instructions
# under the "recording command' settings.
buffers {
  size_kb: 512
  fill_policy: RING_BUFFER
  name: "default"
}
buffers {
  size_kb: 4096
  fill_policy: RING_BUFFER
  name: "process_stats"
}
buffers {
  size_kb: 65536
  fill_policy: RING_BUFFER
  name: "system_metrics"
}
buffers {
  size_kb: 512
  fill_policy: RING_BUFFER
  name: "statsd"
}
buffers {
  size_kb: 40960
  fill_policy: RING_BUFFER
  name: "track_event"
}
# Buffer dedicated for linux.ftrace. It's OK that the trace data is
# overwritten. If there are ftrace events that are of interest, use
# another dedicated buffer or increase this the size of this buffer.
buffers {
  size_kb: 40960
  fill_policy: RING_BUFFER
  name: "ftrace"
}
# Buffer dedicated for input events.
buffers {
  size_kb: 40960
  fill_policy: RING_BUFFER
  name: "input"
}
data_sources {
  config {
    name: "android.packages_list"
    target_buffer_name: "default"
  }
}
data_sources: {
  config {
    name: "linux.process_stats"
    target_buffer_name: "process_stats"
    process_stats_config {
      scan_all_processes_on_start: true
      proc_stats_poll_ms: 1000
    }
  }
}
data_sources {
  config {
    name: "linux.system_info"
    target_buffer_name: "default"
  }
}
data_sources: {
  config {
    name: "linux.sys_stats"
    target_buffer_name: "system_metrics"
    sys_stats_config {
      meminfo_period_ms: 1000
      cpufreq_period_ms: 1000
      cpuidle_period_ms: 1000
      thermal_period_ms: 1000
      diskstat_period_ms: 2000
      psi_period_ms: 2000
      stat_period_ms: 1000
      stat_counters: STAT_CPU_TIMES
      stat_counters: STAT_FORK_COUNT
      vmstat_period_ms: 1000
      vmstat_counters: VMSTAT_PGFAULT
      vmstat_counters: VMSTAT_PGPGIN
      vmstat_counters: VMSTAT_PGPGOUT
      vmstat_counters: VMSTAT_PSWPIN
      vmstat_counters: VMSTAT_PSWPOUT
    }
  }
}
data_sources: {
  config {
    name: "linux.sysfs_power"
    target_buffer_name: "system_metrics"
  }
}
data_sources: {
  config {
    name: "android.power"
    target_buffer_name: "system_metrics"
    android_power_config {
      battery_counters: BATTERY_COUNTER_CAPACITY_PERCENT
      battery_counters: BATTERY_COUNTER_CHARGE
      battery_counters: BATTERY_COUNTER_CURRENT
      battery_counters: BATTERY_COUNTER_CURRENT_AVG
      battery_counters: BATTERY_COUNTER_VOLTAGE
      collect_power_rails: true
    }
  }
}
# TODO(b/389552028): Remove the hardcoded event configs once dynamic resolution is implemented.
data_sources: {
  config {
    name: "linux.perf"
    target_buffer_name: "system_metrics"
    perf_event_config {
      target_cpu: 0
      timebase {
        poll_period_ms: 1000
        name: "msr/tsc/"
        raw_event: {
          type: 14
          config: 0
        }
      }
      followers {
        name: "cstate_pkg/c2-residency/"
        raw_event: {
          type: 27
          config: 0
        }
      }
      followers {
        name: "cstate_pkg/c3-residency/"
        raw_event: {
          type: 27
          config: 1
        }
      }
      followers {
        name: "cstate_pkg/c6-residency/"
        raw_event: {
          type: 27
          config: 2
        }
      }
      followers {
        name: "cstate_pkg/c8-residency/"
        raw_event: {
          type: 27
          config: 4
        }
      }
      followers {
        name: "cstate_pkg/c10-residency/"
        raw_event: {
          type: 27
          config: 6
        }
      }
    }
  }
}
data_sources: {
  config {
    name: "android.statsd"
    target_buffer_name: "statsd"
    statsd_tracing_config {
      push_atom_id: ATOM_APP_COMPACTED_V2
      push_atom_id: ATOM_LMK_KILL_OCCURRED
      push_atom_id: ATOM_LOW_MEM_REPORTED
      push_atom_id: ATOM_PACKAGE_INSTALLER_V2_REPORTED
      push_atom_id: ATOM_PROCESS_LIFE_CYCLE_STATE_CHANGED
      push_atom_id: ATOM_SLOW_INPUT_EVENT_REPORTED
      push_atom_id: ATOM_SLOW_IO
      raw_push_atom_id: 210803
      pull_config {
        pull_atom_id: ATOM_PROCESS_CPU_TIME
        pull_frequency_ms: 500
      }
    }
  }
}
data_sources: {
  config {
    name: "android.surfaceflinger.frametimeline"
    target_buffer_name: "track_event"
  }
}
data_sources: {
  config {
    name: "org.chromium.trace_metadata2"
    target_buffer_name: "track_event"
  }
}
data_sources: {
  config {
    name: "linux.ftrace"
    target_buffer_name: "ftrace"
    ftrace_config {
      ftrace_events: "mm_event/mm_event_record"
      ftrace_events: "kmem/rss_stat"
      throttle_rss_stat: true
      ftrace_events: "ion/ion_stat"
      ftrace_events: "dmabuf_heap/dma_heap_stat"
      ftrace_events: "kmem/ion_heap_grow"
      ftrace_events: "kmem/ion_heap_shrink"
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "sched/sched_switch"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      ftrace_events: "lowmemorykiller/lowmemory_kill"
      ftrace_events: "gpu_mem/gpu_mem_total"
      ftrace_events: "oom/oom_score_adj_update"
      ftrace_events: "ftrace/print"
      atrace_apps: "lmkd"
      atrace_apps: "com.android.vending"
      atrace_categories: "am"
      atrace_categories: "wm"
    }
  }
}
data_sources: {
  config {
    name: "track_event"
    target_buffer_name: "track_event"
    chrome_config {
      trace_config: "{\"record_mode\":\"record-until-full\",\"included_categories\":[\"blink.user_timing\"],\"excluded_categories\":[\"*\"],\"memory_dump_config\":{}}"
      privacy_filtering_enabled: false
      client_priority: USER_INITIATED
    }
    track_event_config {
      disabled_categories: "*"
      enabled_categories: "blink.user_timing"
      enabled_categories: "input"
      enabled_categories: "loading"
      enabled_categories: "__metadata"
      timestamp_unit_multiplier: 1000
      filter_debug_annotations: false
      enable_thread_time_sampling: true
      filter_dynamic_event_names: false
    }
  }
}
data_sources: {
  config {
    name: "org.chromium.histogram_sample"
    target_buffer_name: "track_event"
    chromium_histogram_samples {
      # Wildcard patterns (* and ?) are supported here.
      # After editing, regenerate extra-detailed-trace-config.pbtxt by running:
      #   vpython3 tools/update_trace_config_histograms.py --chromium-src <path>
      histograms {
        histogram_name: "Browser.MainThreadsCongestion"
      }
      histograms {
        histogram_name: "Browser.MainThreadsCongestion.RunningOnly"
      }
      histograms {
        histogram_name: "Browser.Tabs.TabSwitchResult3*"
      }
      histograms {
        histogram_name: "Browser.Tabs.TotalIncompleteSwitchDuration3*"
      }
      histograms {
        histogram_name: "Browser.Tabs.TotalSwitchDuration3*"
      }
      histograms {
        histogram_name: "Compositing.Display.DrawToSwapUs"
      }
      histograms {
        histogram_name: "Compositing.Display.OverlayProcessorUsingStrategy.NumOverlays*"
      }
      histograms {
        histogram_name: "Compositing.Display.OverlayProcessorUsingStrategy.NumOverlaysPromoted"
      }
      histograms {
        histogram_name: "Compositing.Display.PendingSwaps"
      }
      histograms {
        histogram_name: "Compositing.Display.SwapStartToSwapEnd"
      }
      histograms {
        histogram_name: "Event.ScrollJank.*"
      }
      histograms {
        histogram_name: "EventLatency.*"
      }
      histograms {
        histogram_name: "Graphics.Smoothness.Checkerboarding3.AllSequences"
      }
      histograms {
        histogram_name: "Graphics.Smoothness.Checkerboarding4.AllSequences"
      }
      histograms {
        histogram_name: "Graphics.Smoothness.Jank3.AllAnimations"
      }
      histograms {
        histogram_name: "Graphics.Smoothness.Jank3.AllInteractions"
      }
      histograms {
        histogram_name: "Graphics.Smoothness.Jank3.AllSequences"
      }
      histograms {
        histogram_name: "Graphics.Smoothness.PercentDroppedFrames3.AllAnimations"
      }
      histograms {
        histogram_name: "Graphics.Smoothness.PercentDroppedFrames3.AllInteractions"
      }
      histograms {
        histogram_name: "Graphics.Smoothness.PercentDroppedFrames3.AllSequences"
      }
      histograms {
        histogram_name: "Graphics.Smoothness.PercentDroppedFrames4.AllAnimations"
      }
      histograms {
        histogram_name: "Graphics.Smoothness.PercentDroppedFrames4.AllInteractions"
      }
      histograms {
        histogram_name: "Graphics.Smoothness.PercentDroppedFrames4.AllSequences"
      }
      histograms {
        histogram_name: "Memory.Browser.PrivateMemoryFootprint"
      }
      histograms {
        histogram_name: "Memory.Gpu.PrivateMemoryFootprint"
      }
      histograms {
        histogram_name: "Memory.PartitionAlloc.MemoryReclaim"
      }
      histograms {
        histogram_name: "Memory.PartitionAlloc.PeriodicPurge.Subsampled"
      }
      histograms {
        histogram_name: "Memory.Renderer.PrivateMemoryFootprint"
      }
      histograms {
        histogram_name: "Memory.Total.PrivateMemoryFootprint"
      }
      histograms {
        histogram_name: "PageLoad.Experimental.NavigationTiming.NavigationStartToFirstResponseStart"
      }
      histograms {
        histogram_name: "PageLoad.InteractiveTiming.FirstInputDelay4"
      }
      histograms {
        histogram_name: "PageLoad.InteractiveTiming.InputDelay3"
      }
      histograms {
        histogram_name: "PageLoad.InteractiveTiming.ProcessingTime"
      }
      histograms {
        histogram_name: "PageLoad.InteractiveTiming.TimeToNextPaint"
      }
      histograms {
        histogram_name: "PageLoad.InteractiveTiming.UserInteractionLatency.HighPercentile2.MaxEventDuration"
      }
      histograms {
        histogram_name: "PageLoad.InteractiveTiming.WorstUserInteractionLatency.MaxEventDuration"
      }
      histograms {
        histogram_name: "PageLoad.PaintTiming.NavigationToFirstContentfulPaint"
      }
      histograms {
        histogram_name: "PageLoad.PaintTiming.NavigationToLargestContentfulPaint2"
      }
      histograms {
        histogram_name: "Startup.Android.Cold.TimeToFirstContentfulPaint3.Tabbed"
      }
      histograms {
        histogram_name: "Startup.Android.Cold.TimeToFirstVisibleContent4"
      }
      histograms {
        histogram_name: "Startup.FirstWebContents.FirstContentfulPaint"
      }
      histograms {
        histogram_name: "Startup.FirstWebContents.LargestContentfulPaint"
      }
      histograms {
        histogram_name: "Startup.FirstWebContents.NonEmptyPaint3"
      }
      histograms {
        histogram_name: "Viz.DisplayCompositor.OverlayStrategy"
      }
      histograms {
        histogram_name: "Viz.FrameSink.GpuBusyDuration"
      }
      histograms {
        histogram_name: "WebRTC.Video.DecodedFramesPerSecond"
      }
      histograms {
        histogram_name: "WebRTC.Video.DroppedFrames.*"
      }
      histograms {
        histogram_name: "WebRTC.Video.HarmonicFrameRate"
      }
      histograms {
        histogram_name: "WebRTC.Video.RenderFramesPerSecond"
      }
      histograms {
        histogram_name: "WebVitals.FirstContentfulPaint3"
      }
      histograms {
        histogram_name: "WebVitals.InteractionToNextPaint2"
      }
    }
  }
}
data_sources: {
  config {
    name: "android.input.inputevent"
    target_buffer_name: "input"
    android_input_event_config {
      mode: TRACE_MODE_TRACE_ALL
    }
  }
}

# Buffer for extra high-overhead but lossy Chrome trace categories.
buffers {
  size_kb: 20480
  fill_policy: RING_BUFFER
  name: "high_overhead_chrome"
}
data_sources: {
  config {
    name: "track_event"
    target_buffer_name: "high_overhead_chrome"
    track_event_config {
      disabled_categories: "*"
      enabled_categories: "toplevel"
      enabled_categories: "__metadata"
      timestamp_unit_multiplier: 1000
    }
  }
}

write_into_file: true
file_write_period_ms: 5000
max_file_size_bytes: 1073741824
flush_period_ms: 30000
