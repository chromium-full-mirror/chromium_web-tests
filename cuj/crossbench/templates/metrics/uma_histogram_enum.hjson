{
  // Counts one value from one histogram logged with
  // UMA_HISTOGRAM_ENUMERATION macro.
  name: $[NAME]
  sql:
    '''
    INCLUDE PERFETTO MODULE chrome.histograms;

    CREATE PERFETTO TABLE enum_table AS
    SELECT column1 AS name, column2 AS value
    FROM (VALUES $[TABLE] );

    SELECT
    enum_table.name AS name,
    COUNT(*) AS count
    FROM chrome_histograms hist JOIN enum_table
    WHERE hist.value = enum_table.value AND hist.name = '$[NAME]'
    '''
}