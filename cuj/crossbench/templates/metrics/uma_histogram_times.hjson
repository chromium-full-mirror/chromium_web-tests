{
  // Extracts metrics from one histogram logged with the UMA_HISTOGRAM_TIMES
  // macro.
  // Arguments:
  //  NAME: Results will be saved to trace_processor/$[NAME].csv
  //  UNITS_IN_MS: Conversion from the histogram's units to ms. E.g. if the
  //    histogram logs in us, then 1000 because there are 1000 us in 1 ms.
  name: $[NAME]
  sql:
    '''
    INCLUDE PERFETTO MODULE chrome.histograms;
    SELECT
    AVG(hist.value / $[UNITS_IN_MS]) AS 'avg_ms',
    COUNT(*) AS 'count',
    SUM(hist.value / $[UNITS_IN_MS]) AS 'sum_ms',
    MAX(hist.value / $[UNITS_IN_MS]) AS 'max_ms',
    PERCENTILE(hist.value / $[UNITS_IN_MS], 90) AS 'p90_ms',
    PERCENTILE(hist.value / $[UNITS_IN_MS], 50) AS 'p50_ms'
    FROM chrome_histograms hist
    WHERE hist.name = '$[NAME]'
    '''
}