{
  actions: [
    {
      action: "js"
      script: '''performance.mark("click-link-on-page")'''
    }
    {
      action: "click"
      position: {selector: "$[CLICK_SELECTOR]", scroll_into_view: true}
      verify: "$[VERIFY_SELECTOR]"
    }
    {
      action: "wait_for_ready_state"
      ready_state: "complete"
      timeout: "$[PAGE_LOAD_TIMEOUT]"
    }
  ]
}