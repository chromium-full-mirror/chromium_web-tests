{
  actions: [
    {
      action: "js"
      script: "performance.mark('$[SCROLL_MARK_NAME]-start');"
    }
    {
      action: "scroll"
      distance: $[SCROLL_DISTANCE]
      duration: "$[SCROLL_DURATION]"
      source: "$[SCROLL_SOURCE]"
    }
    {
      action: "wait"
      duration: "$[SCROLL_DURATION]"
    }
    {
      action: "scroll"
      distance: $[SCROLL_DISTANCE]
      duration: "$[SCROLL_DURATION]"
      source: "$[SCROLL_SOURCE]"
    }
    {
      action: "wait"
      duration: "$[SCROLL_DURATION]"
    }
    {
      action: "scroll"
      distance: $[SCROLL_DISTANCE]
      duration: "$[SCROLL_DURATION]"
      source: "$[SCROLL_SOURCE]"
    }
    {
      action: "wait"
      duration: "$[SCROLL_DURATION]"
    }
    {
      action: "scroll"
      distance: $[SCROLL_DISTANCE]
      duration: "$[SCROLL_DURATION]"
      source: "$[SCROLL_SOURCE]"
    }
    {
      action: "wait"
      duration: "$[SCROLL_DURATION]"
    }
    {
      action: "scroll"
      distance: $[SCROLL_DISTANCE]
      source: "$[SCROLL_SOURCE]"
      duration: "$[SCROLL_DURATION]"
    }
    {
      action: "wait"
      duration: "$[SCROLL_DURATION]"
    }
    {
      action: "scroll"
      distance: $[SCROLL_DISTANCE]
      source: "$[SCROLL_SOURCE]"
      duration: "$[SCROLL_DURATION]"
    }
    {
      action: "wait"
      duration: "$[SCROLL_DURATION]"
    }
    {
      action: "js"
      script: '''
              performance.mark('$[SCROLL_MARK_NAME]-end', {detail: document.querySelector('$[SCROLL_END_DISTANCE_SELECTOR]').scrollTop});
              performance.measure('$[SCROLL_MARK_NAME]-duration', '$[SCROLL_MARK_NAME]-start', '$[SCROLL_MARK_NAME]-end');
              '''
    }
    // To prevent the page elements from being unstable after operation,
    // which will affect some subsequent operations, a short wait is added here
    {
      action: "wait"
      duration: "2s"
    }
  ]
}