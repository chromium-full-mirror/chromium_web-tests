{
    "page-load": {
        actions: [
            {
                action: "js",
                script: '''
                    performance.mark("page-load", {
                        detail: {
                            url: document.URL
                        }
                    });
                '''
            }
            {
                action: "get"
                url: "$[PAGE_URL]"
                ready_state: "complete"
                timeout: "$[PAGE_LOAD_TIMEOUT]"
                target: "$[TARGET]"
            }
            {
                action: "js",
                script: '''
                    performance.mark("page-loaded", {
                        detail: {
                            url: document.URL
                        }
                    });
                '''
            }
        ]
    }
    "click-link": "action-blocks/basic-action/click-load-page.hjson"
}
