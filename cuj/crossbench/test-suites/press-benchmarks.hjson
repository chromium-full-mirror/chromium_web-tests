// Runs the standard variants of current press benchmarks.
{
  groups: [
    {
      filter_regex: jetstream_2.2
      min_successes: 10
      variants_filter_regex: $
    }
    {
      filter_regex: motionmark_1.3
      min_successes: 10
      variants_filter_regex: $
    }
    {
      filter_regex: speedometer_3.1
      min_successes: 10
      variants_filter_regex: $
    }
    {
      filter_regex: loadline2-tablet
      min_successes: 10
    }
  ]
}
