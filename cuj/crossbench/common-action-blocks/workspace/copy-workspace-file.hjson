{
  actions: [
    {
      action: probe
      probe: google_workspace
      kwargs: {
        action: copy_and_redirect
        template_id: $[TEMPLATE_WORKSPACE_FILE_ID]
      }
    }
    {
      action: wait_for_ready_state
      ready_state: complete
    }
  ]
}
