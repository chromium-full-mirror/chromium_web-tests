{
  pages: {
    WorkspaceWorkflow: {
      login: google
      blocks: {
        setup: $[SETUP_ACTIONS]
        copy-doc: {
          template: ./copy-workspace-file.hjson
          unbound_args: [
            TEMPLATE_WORKSPACE_FILE_ID
          ]
        }
        comment: ./make-comment.hjson
        scroll: ../basic/scroll.hjson
      }
    }
  }
}
