{
  actions: [
    {
      action: meet_create
      bots: {
        num_of_bots: $[NUM_OF_BOTS]
        ttl_secs: $[TTL_SECS]
      }
      timeout: 30s
    }
    {
      action: js
      script: performance.mark("meet-created")
    }
  ]
}