{
  template: "../../templates/probe-config.hjson",
  args: {
    "TRACE_PROCESSOR_QUERIES": [
      "../../templates/metrics/comment_opened.hjson",
      "../../templates/metrics/scroll_duration.hjson",
      "../../templates/metrics/scroll_distance.hjson",
      "../../templates/metrics/cpu_usage_stat.hjson",
      {
        template: "../../templates/metrics/uma_histogram_times.hjson",
        args: {
          NAME: "EventLatency.KeyPressed.TotalLatency",
          UNITS_IN_MS: 1000,
        },
      },
      {
        template: "../../templates/metrics/uma_histogram_times.hjson",
        args: {
          NAME: "PageLoad.InteractiveTiming.TimeToNextPaint",
          UNITS_IN_MS: 1,
        },
      },
      {
        template: "../../templates/metrics/uma_histogram_count.hjson",
        args: { NAME: "Browser.MainThreadsCongestion", }
      },
      {
        template: "../../templates/metrics/uma_histogram_count.hjson",
        args: { NAME: "Graphics.Smoothness.PercentDroppedFrames3.AllSequences", }
      },
      {
        template: "../../templates/metrics/uma_histogram_enum.hjson",
        args: {
          NAME: "Viz.DisplayCompositor.OverlayStrategy",
          TABLE: "('kUnknown', 0), ('kNoStrategyUsed', 1), ('kFullscreen', 2), ('kSingleOnTop', 3)",
        },
      },
    ]
  },
}
