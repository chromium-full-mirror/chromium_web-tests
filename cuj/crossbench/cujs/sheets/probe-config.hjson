{
  template: ../../probe-config.hjson
  args: {
    TRACE_PROCESSOR_QUERIES: [
      ../../common-metrics/comment_opened.hjson
      ../../common-metrics/scroll_duration.hjson
      ../../common-metrics/scroll_distance.hjson
      ../../common-metrics/cpu_usage_stat.hjson
      {
        template: ../../common-metrics/uma_histogram_times.hjson
        args: {
          NAME: EventLatency.KeyPressed.TotalLatency
          UNITS_IN_MS: 1000
        }
      }
      {
        template: ../../common-metrics/uma_histogram_times.hjson
        args: {
          NAME: EventLatency.GestureScrollUpdate.Touchscreen.TotalLatency
          UNITS_IN_MS: 1000
        }
      }
      {
        template: ../../common-metrics/uma_histogram_times.hjson
        args: {
          NAME: PageLoad.InteractiveTiming.TimeToNextPaint
          UNITS_IN_MS: 1
        }
      }
      {
        template: ../../common-metrics/uma_histogram_count.hjson
        args: {
          NAME: Browser.MainThreadsCongestion
        }
      }
      {
        template: ../../common-metrics/uma_histogram_count.hjson
        args: {
          NAME: Browser.MainThreadsCongestion.RunningOnly
        }
      }
      {
        template: ../../common-metrics/uma_histogram_count.hjson
        args: {
          NAME: Graphics.Smoothness.PercentDroppedFrames3.AllSequences
        }
      }
      {
        template: ../../common-metrics/uma_histogram_enum.hjson
        args: {
          NAME: Viz.DisplayCompositor.OverlayStrategy
          TABLE: ('kUnknown', 0), ('kNoStrategyUsed', 1), ('kFullscreen', 2), ('kSingleOnTop', 3)
        }
      }
    ]
    TRACE_PROCESSOR_MODULE_PATHS: [
      ../../common-metrics/trace-processor-modules/web_tests_common
    ]
    TRACE_CONFIG: ../../trace-config/detailed-trace-config.pbtxt
  }
}