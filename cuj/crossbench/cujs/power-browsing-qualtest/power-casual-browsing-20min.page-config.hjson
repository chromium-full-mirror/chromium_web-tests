{
  template: ./action-blocks/power-browsing-short.hjson
  args: {
    // SCROLL args
    SCROLL_DISTANCE: 600
    SCROLL_DURATION: 0.5s
    SCROLL_SOURCE: js
    WAIT_DURATION: 20s
    // PAGE args
    PAGE_LOAD_TIMEOUT: 2m
    REDIRECT_URL: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/v2_config/redirect.html
    VERSION: 2023-08-09
    URL_PREFIX: $[REDIRECT_URL]?ver=$[VERSION]&dest=
    PAGE_1: amazon_search
    PAGE_2: apple
    PAGE_3: bbc
    PAGE_4: google
    PAGE_5: live
    PAGE_6: samsung
    PAGE_7: wattpad
    PAGE_8: wikipedia
    PAGE_9: yahoo
    PAGE_10: yelp
  }
}
