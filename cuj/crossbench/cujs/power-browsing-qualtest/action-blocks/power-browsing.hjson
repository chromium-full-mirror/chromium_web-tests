{
  pages: {
    page-load-and-scroll-1: {
      blocks: {
        template: ./page-load-and-scroll.hjson
        args: {
          PAGE_URL: $[PAGE_URL_1]
          TARGET: $[PAGE_TARGET]
          SCROLL_MARK_NAME: scroll-1
        }
        unbound_args: [
          SCROLL_DOWN_DISTANCE
          SCROLL_UP_DISTANCE
          WAIT_DURATION
          SCROLL_DURATION
          PAGE_LOAD_TIMEOUT
          SCROLL_SOURCE
        ]
      }
    }
