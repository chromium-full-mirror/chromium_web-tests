{
  pages: {
    page-load-and-scroll-1: {
      blocks: {
        template: ./page-load-and-short-scroll.hjson
        args: {
          PAGE_URL: $[URL_PREFIX]$[PAGE_1]
        }
        unbound_args: [
          SCROLL_DISTANCE
          WAIT_DURATION
          SCROLL_DURATION
          PAGE_LOAD_TIMEOUT
          SCROLL_SOURCE
        ]
      }
    }
