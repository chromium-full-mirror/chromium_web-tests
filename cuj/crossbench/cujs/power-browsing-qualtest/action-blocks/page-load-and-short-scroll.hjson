{
  page-load: {
    actions: [
      {
        action: get
        url: $[PAGE_URL]
        ready_state: interactive
        timeout: $[PAGE_LOAD_TIMEOUT]
        target: _self
      }
    ]
  }
  scroll: {
    actions: [
      {
        action: js
        script: performance.mark('scroll-start');
      }
      {
        action: wait
        duration: $[WAIT_DURATION]
      }
      {
        action: scroll
        distance: $[SCROLL_DISTANCE]
        duration: $[SCROLL_DURATION]
        source: $[SCROLL_SOURCE]
      }
      {
        action: wait
        duration: $[WAIT_DURATION]
      }
      {
        action: scroll
        distance: -$[SCROLL_DISTANCE]
        duration: $[SCROLL_DURATION]
        source: $[SCROLL_SOURCE]
      }
      {
        action: wait
        duration: $[WAIT_DURATION]
      }
      {
        action: js
        script:
          '''
          performance.mark('scroll-end', {detail: document.querySelector('html').scrollTop});
          performance.measure('scroll-duration', 'scroll-start', 'scroll-end');
          '''
      }
    ]
  }
}
