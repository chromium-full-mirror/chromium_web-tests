{
  page-load: {
    template: ../../../common-action-blocks/basic/page-load.hjson
    args: {
      READY_STATE: complete
      PAGE_LOAD_TIMEOUT: 3m
    }
    unbound_args: [
      PAGE_URL
      TARGET
    ]
  }
  click-link: [
    {
      action: js
      script: performance.mark("click-link-on-page")
    }
    {
      action: click
      position: {
        selector: $[CLICK_SELECTOR]
        scroll_into_view: true
      }
      verify: $[VERIFY_SELECTOR]
      // Generate a mouse event for getting input events in the trace.
      source: mouse
    }
    {
      // Waiting for document ready state to ensure the content is painted.
      // Need to use PerformanceObserver to ensure LCP.
      action: js
      script:
        '''
          new PerformanceObserver((entryList) => {
            globalThis.largestContentfulPainted = true;
          }).observe({type: 'largest-contentful-paint', buffered: true});
        '''
    }
    {
      action: wait_for_condition
      condition: return globalThis.largestContentfulPainted === true
      timeout: 3m
    }
    {
      action: js
      script: performance.mark("click-link-on-page-loaded")
    }
  ]
}
