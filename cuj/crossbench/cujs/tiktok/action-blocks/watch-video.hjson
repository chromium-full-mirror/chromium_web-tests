{
  actions: [
    {
      action: js
      path: ./scripts/watch-video.js
      replacements: {
        "$[[VIDEO_TIME]": $[VIDEO_TIME]
      }
    }
    {
      action: wait
      duration: $[VIDEO_TIME]
    }
  ]
}