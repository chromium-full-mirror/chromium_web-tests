query {
  id: "tiktok_playback_stats"
  table {
    table_name: "playback_stats_output"
    module_name: "sql_packages.cujs.tiktok.playback_stats"
    column_names: "playback_duration"
    column_names: "playback_resolution_width"
    column_names: "playback_resolution_height"
    column_names: "playback_total_frames"
    column_names: "playback_dropped_frames"
  }
}

metric_spec: {
  id: "cuj.tiktok.playback_duration"
  value: "playback_duration"
  query: {
    inner_query_id: "tiktok_playback_stats"
  }
}

metric_spec: {
  id: "cuj.tiktok.playback_total_frames"
  value: "playback_total_frames"
  query: {
    inner_query_id: "tiktok_playback_stats"
  }
}

metric_spec: {
  id: "cuj.tiktok.playback_dropped_frames"
  value: "playback_dropped_frames"
  query: {
    inner_query_id: "tiktok_playback_stats"
  }
}

metric_spec: {
  id: "cuj.tiktok.playback_resolution_width"
  value: "playback_resolution_width"
  query: {
    inner_query_id: "tiktok_playback_stats"
  }
}

metric_spec: {
  id: "cuj.tiktok.playback_resolution_height"
  value: "playback_resolution_height"
  query: {
    inner_query_id: "tiktok_playback_stats"
  }
}
