{
  actions: [
    {
      action: click
      position: {
        selector: "[aria-label='Call controls'] button[aria-label='More options'][aria-haspopup='menu']"
        required: true
        wait: true
      }
      source: $[CLICK_INPUT_SOURCE]
      verify: xpath///*[text()='Settings']
    }
    {
      action: click
      position: {
        selector: xpath///*[text()='Settings']
        required: true
        scroll_into_view: true
        wait: true
      }
      source: $[CLICK_INPUT_SOURCE]
      verify: button[aria-label='Video']
    }
    {
      action: click
      position: {
        selector: button[aria-label='Video']
        required: true
        wait: true
      }
      source: $[CLICK_INPUT_SOURCE]
    }
    {
      action: click
      position: {
        selector: "[aria-label='Send resolution (maximum)'][aria-haspopup='listbox']"
        required: true
        wait: true
      }
      source: $[CLICK_INPUT_SOURCE]
      verify: "[aria-label='Send resolution (maximum)'][aria-haspopup='listbox'][aria-expanded='true']"
      attempts: 3
      timeout: 5s
    }
        // Wait for the dropdown combobox to finish the amination.
        // TODO: Remove after click action supports waiting for stable position.
    {
      action: wait
      duration: 0.5s
    }
    {
      action: click
      position: {
        selector: "[aria-label='Send resolution (maximum)'] [role='option'][aria-label='$[SEND_RESOLUTION]']"
        required: true
        wait: true
      }
      source: $[CLICK_INPUT_SOURCE]
      verify: "[aria-label='Send resolution (maximum)'] span[aria-label='$[SEND_RESOLUTION]']"
    }
    {
      action: click
      position: {
        selector: "[aria-label='Receive resolution (maximum)'][aria-haspopup='listbox']"
        required: true
        wait: true
      }
      source: $[CLICK_INPUT_SOURCE]
      verify: "[aria-label='Receive resolution (maximum)'][aria-haspopup='listbox'][aria-expanded='true']"
      attempts: 3
      timeout: 5s
    }
        // Wait for the dropdown combobox to finish the amination.
        // TODO: Remove after click action supports waiting for stable position.
    {
      action: wait
      duration: 0.5s
    }
    {
      action: click
      position: {
        selector: "[aria-label='Receive resolution (maximum)'] [role='option'][aria-label='$[RECEIVE_RESOLUTION]']"
        required: true
        wait: true
      }
      source: $[CLICK_INPUT_SOURCE]
      verify: "[aria-label='Receive resolution (maximum)'] span[aria-label='$[RECEIVE_RESOLUTION]']"
    }
    {
      action: click
      position: {
        selector: button[aria-label='Close dialog']
        required: true
        wait: true
      }
      source: $[CLICK_INPUT_SOURCE]
      verify: body:not(:has([aria-modal='true']))
    }
  ]
}