{
  template: ./action-blocks/meet-note.hjson
  args: {
    DOCS_URL: https://docs.new
    TIMEOUT: 2m
    CLICK_INPUT_SOURCE: touch
    NOTE_TEXT: "the quick brown fox jumps over the lazy dog. "
    NOTE_DURATION: 20s
    NUM_OF_BOTS: "8"
    TTL_SECS: "180"
    SEND_RESOLUTION: High definition (720p)
    RECEIVE_RESOLUTION: High definition (720p)
  }
}
