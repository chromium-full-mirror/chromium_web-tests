{
  template: ../../probe-config.hjson
  args: {
    METRIC_DEFINITIONS: [
      ../../common-metrics/meminfo_total.textproto
      ../../common-metrics/meminfo_per_iteration.textproto
      ../../common-metrics/heap_activity.textproto
      ../../common-metrics/heap_drawable.textproto
      ../../common-metrics/heap_total.textproto
      ../../common-metrics/heap_view.textproto
    ]
    TRACE_CONFIG: ../../trace-config/long-running-trace-config.pbtxt
    ADDITIONAL_PROBES: [
      {
        name: dump_heap
      }
    ]
  }
}
