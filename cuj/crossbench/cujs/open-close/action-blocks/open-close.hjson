{
  actions: [
    {
      action: get
      url: $[URL]
      target: $[TARGET]
      ready_state: complete
      timeout: 2m
    }
    {
      action: raw_input
      events: [
        {
          type: key
          key_code: ControlLeft
          is_down: true
        }
        {
          type: wait
          duration: 50ms
        }
        {
          type: key
          key_code: KeyW
          is_down: true
        }
        {
          type: wait
          duration: 50ms
        }
        {
          type: key
          key_code: KeyW
          is_down: false
        }
        {
          type: wait
          duration: 50ms
        }
        {
          type: key
          key_code: ControlLeft
          is_down: false
        }
      ]
    }
    {
      action: switch_tab
      tab_index: 0
    }
    {
      action: meminfo
      system: true
      title: closed
    }
  ]
  teardown: [
    {
      action: probe
      probe: dump_heap
      kwargs: {
        type: java
      }
    }
  ]
}
