{
  setup: [
    {
      action: get
      url: $[PAGE_URL]
      ready_state: complete
      timeout: $[PAGE_LOAD_TIMEOUT]
      target: $[TARGET]
    }
  ]
  actions: [
    {
      action: switch_tab
      tab_index: $[TAB_INDEX]
    }
    // A condition is being added to identify if the actual page not loaded
    // due to other reasons (e.g. certificate error, offline, connection timeout, etc.)
    {
      action: wait_for_condition
      condition: return document.getElementsByClassName("interstitial-wrapper").length != 1
      timeout: 5s
    }
    {
      action: js
      script: performance.mark('scroll-start');
    }
    {
      action: scroll
      distance: $[SCROLL_DISTANCE]
      duration: $[SCROLL_DURATION]
      source: $[SCROLL_SOURCE]
    }
    {
      action: wait
      duration: $[WAIT_DURATION]
    }
    {
      action: scroll
      distance: -$[SCROLL_DISTANCE]
      duration: $[SCROLL_DURATION]
      source: $[SCROLL_SOURCE]
    }
    {
      action: wait
      duration: $[WAIT_DURATION]
    }
    {
      action: scroll
      distance: $[SCROLL_DISTANCE]
      duration: $[SCROLL_DURATION]
      source: $[SCROLL_SOURCE]
    }
    {
      action: wait
      duration: $[WAIT_DURATION]
    }
    {
      action: scroll
      distance: -$[SCROLL_DISTANCE]
      duration: $[SCROLL_DURATION]
      source: $[SCROLL_SOURCE]
    }
    {
      action: wait
      duration: $[WAIT_DURATION]
    }
    {
      action: scroll
      distance: $[SCROLL_DISTANCE]
      duration: $[SCROLL_DURATION]
      source: $[SCROLL_SOURCE]
    }
    {
      action: wait
      duration: $[WAIT_DURATION]
    }
    {
      action: scroll
      distance: -$[SCROLL_DISTANCE]
      duration: $[SCROLL_DURATION]
      source: $[SCROLL_SOURCE]
    }
    {
      action: wait
      duration: $[WAIT_DURATION]
    }
    {
      action: scroll
      distance: $[SCROLL_DISTANCE]
      duration: $[SCROLL_DURATION]
      source: $[SCROLL_SOURCE]
    }
    {
      action: wait
      duration: $[WAIT_DURATION]
    }
    {
      action: scroll
      distance: -$[SCROLL_DISTANCE]
      duration: $[SCROLL_DURATION]
      source: $[SCROLL_SOURCE]
    }
    {
      action: wait
      duration: $[WAIT_DURATION]
    }
    {
      action: js
      script:
        '''
        performance.mark('scroll-end', {detail: document.querySelector('html').scrollTop});
        performance.measure('scroll-duration', 'scroll-start', 'scroll-end');
        '''
    }
  ]
}
