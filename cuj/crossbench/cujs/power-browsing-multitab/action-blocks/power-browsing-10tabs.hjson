{
  pages: {
    page-scroll-1: {
      template: ./switch-tab-and-page-scroll.hjson
      args: {
        PAGE_URL: $[URL_PREFIX]$[PAGE_1]
        TARGET: _self
        TAB_INDEX: 0
      }
      unbound_args: [
        PAGE_LOAD_TIMEOUT
        SCROLL_DISTANCE
        SCROLL_DURATION
        SCROLL_SOURCE
        WAIT_DURATION
      ]
    }
    page-scroll-2: {
      template: ./switch-tab-and-page-scroll.hjson
      args: {
        PAGE_URL: $[URL_PREFIX]$[PAGE_2]
