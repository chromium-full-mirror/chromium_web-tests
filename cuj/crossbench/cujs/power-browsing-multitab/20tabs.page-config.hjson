{
  args: {
    // PAGE args
    REDIRECT_URL: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/v2_config/redirect.html
    VERSION: 2023-08-09
    URL_PREFIX: $[REDIRECT_URL]?ver=$[VERSION]&dest=
  }
  template: {
    pages: {
      page-scroll-1: {
        template: ./action-blocks/switch-tab-and-page-scroll.hjson
        args: {
          PAGE_URL: $[URL_PREFIX]amazon_product
          TARGET: _self
          TAB_INDEX: 0
        }
        unbound_args: [
          URL_PREFIX
        ]
      }
      page-scroll-2: {
        template: ./action-blocks/switch-tab-and-page-scroll.hjson
        args: {
          PAGE_URL: $[URL_PREFIX]amazon_search
          TARGET: _new_tab
          TAB_INDEX: 1
        }
        unbound_args: [
          URL_PREFIX
        ]
      }
