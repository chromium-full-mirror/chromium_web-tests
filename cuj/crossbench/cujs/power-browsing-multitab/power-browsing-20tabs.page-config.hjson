{
  template: ./action-blocks/power-browsing-20tabs.hjson
  args: {
    // SCROLL args
    SCROLL_DISTANCE: 600
    SCROLL_DURATION: 2.5s
    SCROLL_SOURCE: js
    WAIT_DURATION: 20s
    // PAGE args
    PAGE_LOAD_TIMEOUT: 2m
    REDIRECT_URL: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/v2_config/redirect.html
    VERSION: 2023-08-09
    URL_PREFIX: $[REDIRECT_URL]?ver=$[VERSION]&dest=
    PAGE_1: amazon_product
    PAGE_2: amazon_search
    PAGE_3: apple
    PAGE_4: ebay
    PAGE_5: google
    PAGE_6: imdb
    PAGE_7: weather
    PAGE_8: office
    PAGE_9: stackoverflow
    PAGE_10: wikipedia
    PAGE_11: amazon_search
    PAGE_12: apple
    PAGE_13: bbc
    PAGE_14: google
    PAGE_15: live
    PAGE_16: samsung
    PAGE_17: wattpad
    PAGE_18: wikipedia
    PAGE_19: yahoo
    PAGE_20: yelp
  }
}