{
  pages: {
    Gmail-Compose: {
      login: google
      blocks: {
        //Load gmail home page.
        page-load: {
          actions: [
            {
              action: get
              url: https://mail.google.com/
              ready_state: complete
              timeout: $[TIMEOUT]
            }
          ]
        }
        //When gmail page loded, two popup may appear in the bottom of the page, which need to be closed.
        popup-close: ./popup-close.hjson
        //Input text into subject and body of email.
        compose: ./compose.hjson
        //Click the 'trash bin' icon to discard the draft.
        draft-discard: ./discard.hjson
      }
    }
  }
}
