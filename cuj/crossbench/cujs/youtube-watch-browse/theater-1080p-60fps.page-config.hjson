{
  args: {
    PAGE_URL: https://www.youtube.com/watch?v=LXb3EKWsInQ
    TIMEOUT: 2m
    VIDEO_SELECTOR: video:not(.ad-showing video):not(.unstarted-mode video):not(.buffering-mode video)
    // video run time, s=seconds,h=hours,m=minutes
    VIDEO_TIME: 120s
    // f is Full screen; t is theater mode, default input other word in it
    CHANGE_SCREEN_INPUT: t
    // switch resolution  e.g. 1080p 720p 480p 360p 240p 144p Auto
    // Please check the supported resolutions of the video.
    // The resolution of the sample may not be supported.
    RESOLUTION_TEXT: 1080p60
    // scroll
    SCROLL_MARK_NAME: scroll
    SCROLL_END_DISTANCE_SELECTOR: html
    SCROLL_DURATION: 0.5s
    SCROLL_SOURCE: touch
    //new window url
    NEW_WINDOW_PAGE_URL: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/bbc.html
  }
  template: ./action-blocks/youtube-watch-browse.hjson
}
