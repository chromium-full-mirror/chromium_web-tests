{
  template: ../../probe-config.hjson
  args: {
    METRIC_DEFINITIONS: [
      ./metrics.textproto
      ../../common-metrics/tab_open_latency.textproto
      ../../common-metrics/meminfo_total.textproto
      ../../common-metrics/dom_complete.textproto
    ]
    TRACE_CONFIG: ../../trace-config/long-running-trace-config.pbtxt
    ADDITIONAL_PROBES: []
  }
}
