{
  template: ../../probe-config.hjson
  args: {
    TRACE_PROCESSOR_QUERIES: [
      {
        name: Total Renderers
        sql: ./queries/total_renderers.sql
      }
      {
        template: ../../common-metrics/uma_histogram_count.hjson
        args: {
          NAME: Discarding.DiscardingProtectedTab
        }
      }
      {
        template: ../../common-metrics/uma_histogram_count.hjson
        args: {
          NAME: Discarding.DiscardingFocusedTab
        }
      }
      ../../common-metrics/lmk_kill_list.hjson
      ../../common-metrics/lmk_kill_count.hjson
      ../../common-metrics/tab_open_latency.hjson
    ]
    TRACE_PROCESSOR_MODULE_PATHS: [
      ../../sql_packages
    ]
    TRACE_CONFIG: ../../trace-config/long-running-trace-config.pbtxt
  }
}
