{
  template: ./action-blocks/tab-stress-template.hjson
  args: {
    PAGE_URL0: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/amazon_product.html
    PAGE_URL1: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/aajtak.html
    PAGE_URL2: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/apple.html
    PAGE_URL3: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/ebay.html
    PAGE_URL4: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/google.html
    PAGE_URL5: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/wattpad.html
    PAGE_URL6: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/bbc.html
    PAGE_URL7: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/yahoo.html
    PAGE_URL8: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/stackoverflow.html
    PAGE_URL9: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/wikipedia.html
    SWITCH_TARGET0: .*amazon_product.*
    SWITCH_TARGET1: .*aajtak.*
    SWITCH_TARGET2: .*apple.*
    SWITCH_TARGET3: .*ebay.*
    SWITCH_TARGET4: .*google.*
    SWITCH_TARGET5: .*wattpad.*
    SWITCH_TARGET6: .*bbc.*
    SWITCH_TARGET7: .*yahoo.*
    SWITCH_TARGET8: .*stackoverflow.*
    SWITCH_TARGET9: .*wikipedia.*
  }
}
