// Opens tabs, waits for ready-state complete, and then cycles through all the opened tabs.
// To change the number of tabs that are opened, add additional open and cycle blocks.
// Copyright 2025 The Chromium Authors
// Use of this source code is governed by a BSD-style license that can be
// found in the LICENSE file.
{
  pages: {
    tab-stress: {
      setup: {
        args: {
          OPEN10: ./open-10-tabs.hjson
        }
        template: [
          $[...OPEN10]
          $[...OPEN10]
          $[...OPEN10]
          $[...OPEN10]
          $[...OPEN10]
          $[...OPEN10]
          $[...OPEN10]
          $[...OPEN10]
          $[...OPEN10]
          $[...OPEN10]
          {
            action: meminfo
            title: after_open
          }
        ]
      }
      actions: {
        args: {
          CYCLE10: ./cycle-10-tabs.hjson
        }
        template: [
          {
            action: switch_tab
            tab_index: 0
            url: data:text
          }
          $[...CYCLE10]
          $[...CYCLE10]
          $[...CYCLE10]
          $[...CYCLE10]
          $[...CYCLE10]
          $[...CYCLE10]
          $[...CYCLE10]
          $[...CYCLE10]
          $[...CYCLE10]
          $[...CYCLE10]
          {
            // Make sure we cycled though everything
            action: switch_tab
            relative_tab_index: 1
            url: data:text
          }
          {
            action: meminfo
            title: after_switch
          }
        ]
      }
    }
  }
}
