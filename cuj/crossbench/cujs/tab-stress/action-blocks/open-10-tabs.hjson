{
  "tab-stress-$[ITER_COUNT]0": {
    template: ./page-load.hjson
    args: {
      PAGE_URL: $[PAGE_URL0]
      TARGET: _new_tab
      PAGE_LOAD_TIMEOUT: 3m
    }
    unbound_args: [
      PAGE_URL0
    ]
  }
