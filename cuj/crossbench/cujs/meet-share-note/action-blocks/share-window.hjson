{
  template: ./meet-share-note.hjson
  args: {
    SHARE_DIALOG_ACTIONS: [
      // Switch to "Share app window" mode in the SystemUI share picker
      {
        action: click
        position: {
          res: ShareAppWindowOption
          required: true
        }
        source: touch
        timeout: 10s
      }
      {
        action: wait
        duration: 1s
      }
      // Select the Chrome window in the app list
      {
        action: click
        position: {
          pkg: com.android.systemui
          text: Chrome
          required: true
        }
        source: touch
        timeout: 10s
      }
    ]
  }
  unbound_args: [
    NUM_BOTS
    BACKGROUND_BLUR
  ]
}
