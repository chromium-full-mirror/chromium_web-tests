{
  template: ./meet-share-note.hjson
  args: {
    SHARE_DIALOG_ACTIONS: [
      // Select the Docs tab in the SystemUI share picker
      {
        action: click
        position: {
          pkg: com.android.systemui
          text: Untitled document - Google Docs
          required: true
        }
        source: touch
        timeout: 10s
      }
    ]
  }
  unbound_args: [
    NUM_BOTS
    BACKGROUND_BLUR
  ]
}
