{
  pages: {
    start-mark: {
      actions: [
        {
          action: js
          script: performance.mark("iteration-start");
        }
      ]
    }
    open-10-0: {
      blocks: {
        template: ./action-blocks/open-10.hjson
        args: {
          INDEX_PREFIX: ""
        }
      }
    }
    wait-for-ready-0: {
      blocks: {
        template: ./action-blocks/wait-for-ready.hjson
        args: {
          INDEX_PREFIX: ""
        }
      }
    }
    end-mark: {
      actions: [
        {
          action: js
          script: performance.mark("iteration-end");
        }
      ]
    }
  }
}