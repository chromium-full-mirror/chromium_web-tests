{
  args: {
    // SCROLL args
    SCROLL_DISTANCE: 300
    SCROLL_DURATION: 0.5s
    SCROLL_SOURCE: touch
    // PAGE args
    PAGE_LOAD_TIMEOUT: 2m
  }
  template: {
    pages: {
      page-load-and-scroll-1: {
        blocks: {
          template: ./action-blocks/page-load-and-scroll.hjson
          args: {
            PAGE_URL: https://storage.googleapis.com/chromiumos-test-assets-public/power_LoadTest/2023-08-09/amazon_product.html
            TARGET: _self
          }
          unbound_args: [
            PAGE_LOAD_TIMEOUT
            SCROLL_DISTANCE
            SCROLL_SOURCE
            SCROLL_DURATION
          ]
        }
      }
      page-load-and-scroll-2: {
