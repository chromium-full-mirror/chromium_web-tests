{
  template: ./action-blocks/page-scroll.hjson
  args: {
    // SCROLL args
    SCROLL_DISTANCE: "300"
    SCROLL_DURATION: 0.5s
    SCROLL_SOURCE: touch
    // PAGE args
    PAGE_LOAD_TIMEOUT: 2m
    PAGE_TARGET: _self
  }
}
