{
  page-load: {
    actions: [
      {
        action: get
        url: $[PAGE_URL]
        ready_state: complete
        timeout: $[PAGE_LOAD_TIMEOUT]
        target: $[TARGET]
      }
    ]
  }
  scroll: ../../../common-action-blocks/basic/scroll-no-selector.hjson
}